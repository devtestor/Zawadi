# Dev `docker compose up -d --build` reads variables from this file.
# Copy to .env and fill in the real values.

POSTGRES_USER=zawadi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zawadi

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BACKEND_URL=http://localhost:3000

# Storage. Development falls back to local uploads when S3 is empty.
# Production should use S3 / Cloudflare R2 / MinIO.
STORAGE_PROVIDER=s3
LOCAL_UPLOAD_DIR=uploads
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base url where uploaded files are served from (e.g. R2 custom domain)
S3_PUBLIC_URL=

# Pesapal (sandbox) — optional for boost + wallet top-up
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CURRENCY=KES
PESAPAL_IPN_ID=
